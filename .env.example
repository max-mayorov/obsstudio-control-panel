# --- OBS connection -------------------------------------------------------------
# Enable the server in OBS first: Tools -> WebSocket Server Settings -> Enable.
# Host:port is accepted too; ws:// is added if you leave the scheme off.
OBS_URL=ws://127.0.0.1:4455

# Leave blank if "Enable Authentication" is unchecked in OBS.
OBS_PASSWORD=

# Recording heartbeat. OBS emits no timecode event, so the timecode and byte count are
# sampled over the open websocket while recording (see DESIGN.md section 8).
# Set to 0 to disable sampling and extrapolate the timecode in the browser instead.
OBS_POLL_INTERVAL_MS=1000

# Reconnect backoff bounds, in milliseconds.
OBS_RECONNECT_INITIAL_MS=500
OBS_RECONNECT_MAX_MS=15000

# --- Application ----------------------------------------------------------------
# Shared secret for the API. If unset, the API is UNAUTHENTICATED: anyone who can
# reach the port can stop a recording. Fine on loopback, not on a shared network.
APP_TOKEN=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Consumed by adapter-node at runtime.
HOST=127.0.0.1
PORT=3000
